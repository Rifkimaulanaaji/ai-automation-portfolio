        "operation": "executeQuery",
        "query": "with updated as (\n  update public.lead_buffer\n  set status = case when attempt_count < 3 then 'pending' else 'failure_data' end,\n      notes = concat_ws(E'\\n', notes,\n        to_char(now() at time zone 'Asia/Jakarta', 'YYYY-MM-DD HH24:MI:SS')\n        || ' | CRM 500 | percobaan ' || attempt_count || '/3'\n        || case when attempt_count < 3 then ' | kembali ke pending'\n                else ' | jatah habis, ke failure_data' end)\n  where lead_id = $1 and status = 'processing'\n  returning lead_id, name, phone, context, attempt_count, status, notes\n)\ninsert into public.faillog (lead_id, name, phone, context, attempt_count, http_status, error_detail, notes)\nselect lead_id, name, phone, context, attempt_count, $2::int, $3::text, notes\nfrom updated\nwhere status = 'failure_data'\nreturning id, lead_id;",
